{
  "name": "cypress-kitchen-sink-testing",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive web components testing of the Cypress Kitchen Sink with Cypress: form controls, navigation, assertions and UI interactions, plus black-box, white-box, accessibility, visual, performance, security and mutation testing.",
  "author": "Raktim Chandra",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "serve --listen 8080 --no-request-logging --no-clipboard",
    "start:coverage": "node tools/instrument.js && serve instrumented --listen 8080 --no-request-logging --no-clipboard",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test": "start-server-and-test start http://localhost:8080 cy:run",
    "test:chrome": "start-server-and-test start http://localhost:8080 \"cypress run --browser chrome\"",
    "test:firefox": "start-server-and-test start http://localhost:8080 \"cypress run --browser firefox\"",
    "test:edge": "start-server-and-test start http://localhost:8080 \"cypress run --browser edge\"",
    "test:smoke": "start-server-and-test start http://localhost:8080 \"cypress run --spec cypress/e2e/01-smoke/**\"",
    "test:demo": "start-server-and-test start http://localhost:8080 \"cypress run --headed --browser chrome --spec cypress/e2e/03-form-controls/**,cypress/e2e/02-navigation/**,cypress/e2e/05-assertions/**,cypress/e2e/04-ui-interactions/**\"",
    "test:coverage": "start-server-and-test start:coverage http://localhost:8080 \"cypress run --expose coverage=true\"",
    "mutation": "node tools/mutation.js",
    "report": "node tools/aggregate.js",
    "lint": "eslint .",
    "deliverables": "make deliverables"
  },
  "devDependencies": {
    "@cypress/code-coverage": "4.1.3",
    "@cypress/grep": "7.0.0",
    "axe-core": "4.11.4",
    "cypress": "16.2.1",
    "cypress-multi-reporters": "2.1.0",
    "cypress-real-events": "1.15.1",
    "eslint": "10.12.0",
    "eslint-plugin-cypress": "7.0.2",
    "globals": "17.13.0",
    "mocha-junit-reporter": "2.2.1",
    "mochawesome": "8.1.1",
    "mochawesome-merge": "5.1.1",
    "mochawesome-report-generator": "6.3.2",
    "nyc": "18.0.0",
    "pixelmatch": "5.3.0",
    "pngjs": "7.0.0",
    "serve": "14.2.6",
    "start-server-and-test": "3.0.13"
  }
}
